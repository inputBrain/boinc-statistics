{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "WorkerConfig": {
    "IsDeveloperMode": false,
    "SkipFirstN": 0,
    "FlareSolverr": {
      "Url": "http://localhost:8191/v1",
      "MaxTimeoutMs": 90000
    },
    "Tor": {
      "ControlHost": "localhost",
      "ControlPort": 9051,
      "ControlPassword": "<must match docker/.env TOR_CONTROL_PASSWORD>",
      "SocksHostForFlareSolverr": "tor",
      "SocksPort": 9050,
      "WaitAfterNewnymSec": 10
    },
    "Retry": {
      "MaxAttempts": 5
    },
    "Parallelism": {
      "Projects": 4,
      "Pages": 2
    },
    "Scraping": {
      "MaxPages": 2,
      "PageSize": 100
    },
    "Delay": {
      "BetweenProjectsMinMs": 30000,
      "BetweenProjectsMaxMs": 60000,
      "DevModeMs": 1000
    },
    "Schedule": {
      "Enabled": true,
      "TimeZone": "Europe/Kyiv",
      "RunAtKyivTimes": ["08:00", "15:00"]
    }
  },
  "ConnectionStrings": {
    "PostgreSqlConnection": "User ID=postgres;Password=[password];Host=localhost;Port=5432;Database=[db_name];Pooling=true;"
  },
  "AllowedHosts": "*"
}
